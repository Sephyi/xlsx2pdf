{
  "name": "xlsx2pdf",
  "version": "1.0.0",
  "description": "Convert Excel files to PDF with drag and drop",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:win": "bun build src/index.ts --minify --compile --outfile ./build/xlsx2pdf.exe",
    "build:mac": "bun build src/index.ts --minify --compile --outfile ./build/xlsx2pdf-mac",
    "build:linux": "bun build src/index.ts --minify --compile --outfile ./build/xlsx2pdf-linux",
    "clean": "rm -rf ./build && mkdir -p ./build",
    "predeploy": "bun run clean && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sephyi/xlsx2pdf.git"
  },
  "keywords": [
    "excel",
    "pdf",
    "converter",
    "xlsx",
    "libreoffice"
  ],
  "author": "Sephyi",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
